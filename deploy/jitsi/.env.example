# =============================================================================
# Configuration of the video machine. Copy this file to deploy/jitsi/.env and fill it in:
#
#     cp .env.example .env && chmod 600 .env
#
# deploy/jitsi/.env is ignored by git and holds secrets: never commit it, never paste it in a chat
# or an issue. Every value below that says "secret" is a placeholder here; generate your own with
#
#     openssl rand -base64 48
# =============================================================================


# ----- Where the stack lives --------------------------------------------------

# Not secret. The hostname this machine answers at, without https://: meet.<domain> on a domain you
# control, or the name Azure gives the machine's public IP (ayni-meet.centralus.cloudapp.azure.com,
# see deploy/README.md). It needs a DNS name pointing at this machine, and AYNI_JITSI_URL in
# deploy/backend/.env is https:// and this name.
AYNI_MEET_HOST=meet.example.org

# Not secret. The public IPv4 address of this machine, not of the backend's. The videobridge tells
# browsers to send the media there. If the machine sits behind a NAT, it is the address outside it.
AYNI_JITSI_PUBLIC_IP=203.0.113.20

# Not secret. An address the certificate authority may write to about an expiring certificate.
ACME_EMAIL=ops@example.org


# ----- The passes the backend signs -------------------------------------------

# SECRET. The secret Jitsi checks the video passes with. It must be the exact value of
# AYNI_JITSI_JWT_SECRET in deploy/backend/.env: with another one every pass is refused.
AYNI_JITSI_JWT_SECRET=change-me-at-least-32-characters-long-jitsi-secret

# Not secret. The issuer Jitsi accepts. The same value as in deploy/backend/.env; the default works.
AYNI_JITSI_APP_ID=ayni


# ----- Inside Jitsi -------------------------------------------------------------

# SECRET. Passwords the Jitsi components use among themselves; nothing outside this machine uses
# them. One different value each: openssl rand -base64 48
JICOFO_AUTH_PASSWORD=change-me-jicofo-password
JICOFO_COMPONENT_SECRET=change-me-jicofo-component-secret
JVB_AUTH_PASSWORD=change-me-jvb-password

# Not secret. The heaps of the two Java components. The images default to 3 GB each; these fit a
# machine of 1 GB (deploy/README.md, "Memory of the video machine"). Raise them on a larger one.
JICOFO_MAX_MEMORY=256m
VIDEOBRIDGE_MAX_MEMORY=384m
