# The proxy of the production stack. Caddy gets and renews a TLS certificate for each hostname
# below by itself. {$NAME} is replaced by the environment of the proxy container, which
# docker-compose.prod.yml fills from deploy/.env.

{
	# The address the certificate authority writes to about an expiring certificate or a problem.
	email {$ACME_EMAIL}
}

# Headers every site of the stack answers with. HSTS tells a browser that has seen the site once to
# refuse plain HTTP to it for a year; it names no subdomain, so other names of the domain are not
# bound by it. The referrer policy keeps the access link, which carries its token in the address,
# from reaching another site in a Referer header: only the origin crosses.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# api.<domain>: the backend on its own hostname, for Swagger UI (when enabled) and any client that
# is not the web application. Caddy forwards WebSocket upgrades (the whiteboard) without help and
# adds X-Forwarded-For, -Host and -Proto, which the prod profile trusts.
api.{$AYNI_DOMAIN} {
	import security_headers
	encode zstd gzip

	# Evidence uploads are up to three files of 5 MB (16 MB per request in application.yml).
	request_body {
		max_size 20MB
	}

	reverse_proxy backend:{$AYNI_PORT} {
		# Takes the backend out of rotation while its readiness is not UP, for instance during a
		# graceful stop.
		health_uri /actuator/health/readiness
		health_interval 10s
	}
}

# app.<domain>: the web application and the API on one origin. The web application calls "/api"
# with a relative address, so serving both here needs no CORS: the browser sees a single origin.
# Set AYNI_ALLOWED_ORIGINS to https://app.<domain> all the same: the whiteboard's WebSocket checks it.
app.{$AYNI_DOMAIN} {
	import security_headers
	# Nothing frames the web application, so no other site may put it in a frame.
	header X-Frame-Options DENY
	encode zstd gzip

	@backend path /api/* /actuator/health /actuator/health/*
	handle @backend {
		request_body {
			max_size 20MB
		}
		reverse_proxy backend:{$AYNI_PORT}
	}

	handle {
		root * /srv/app

		# The files under assets/ carry a hash of their content in the name, so a browser may keep
		# them for good. Everything else is index.html under some route, which names those files
		# and has to be asked for again after an update.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"

		# A route of the single page application (for example /access/confirm) is index.html.
		try_files {path} /index.html
		file_server
	}
}

# meet.<domain>: Jitsi. It needs HTTPS, because a browser only gives a page the camera and the
# microphone over it. The media does not pass through here: it goes over 10000/udp straight to the
# videobridge.
meet.{$AYNI_DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy jitsi-web:80
}

# The page of the optional Mailpit, behind a user and a password. With the mailpit profile off the
# address is an http one that nothing outside the container reaches (docker-compose.prod.yml).
{$MAILPIT_SITE} {
	basic_auth {
		{$MAILPIT_BASIC_AUTH_USER} {$MAILPIT_PASSWORD_HASH}
	}
	reverse_proxy mailpit:8025
}
