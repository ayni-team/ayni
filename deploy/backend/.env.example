# =============================================================================
# Configuration of the backend machine. Copy this file to deploy/backend/.env and fill it in:
#
#     cp .env.example .env && chmod 600 .env
#
# deploy/backend/.env is ignored by git and holds secrets: never commit it, never paste it in a
# chat or an issue. Every value below that says "secret" is a placeholder here; generate your own
# with
#
#     openssl rand -base64 48
#
# An unquoted value ends at the end of the line. Wrap in single quotes any value that contains a
# dollar sign (a bcrypt hash) or a space. The meaning of each application variable is in the
# "Deployment (prod profile)" section of docs/backend-guide.md.
# =============================================================================


# ----- Where the stack lives --------------------------------------------------

# Not secret. The domain you control. This machine answers at api.<domain> and app.<domain>, so
# those two names need a DNS record pointing at it; meet.<domain> points at the video machine.
AYNI_DOMAIN=example.org

# Not secret. An address the certificate authority may write to about an expiring certificate.
ACME_EMAIL=ops@example.org

# Not secret. The image the release workflow publishes (ghcr.io/<owner>/ayni-backend, lower case)
# and the version to run: the git tag, for example v1.0.0. deploy/backend/update.sh and the deploy
# workflow rewrite the tag; to go back to a previous version, put its tag here (see
# deploy/README.md).
AYNI_IMAGE_REPOSITORY=ghcr.io/ayni-team/ayni-backend
AYNI_IMAGE_TAG=v0.0.0


# ----- Database (required) ----------------------------------------------------

# Not secret. JDBC URL of the managed PostgreSQL. Keep sslmode=require: without it the password and
# the data travel in the clear. The server name is the one the provider gives you.
AYNI_DB_URL=jdbc:postgresql://your-server.postgres.database.azure.com:5432/ayni?sslmode=require

# Not secret. The owner role. Flyway migrates as it, it owns every table, and the application never
# connects as it.
AYNI_DB_USER=ayni

# SECRET. The owner's password: openssl rand -base64 48
AYNI_DB_PASSWORD=change-me-owner-password

# Not secret. The role the application connects as. It must have no BYPASSRLS, no superuser and own
# nothing, or the isolation between universities does not apply (deploy/README.md, "The database").
AYNI_DB_APP_USER=ayni_app

# SECRET. Its password. If you created the role beforehand, this is the password you gave it;
# otherwise the first migration creates the role with this one.
AYNI_DB_APP_PASSWORD=change-me-application-password

# Not secret. Most connections the application keeps open. Keep the sum over all instances below
# the server's connection limit.
AYNI_DB_POOL_SIZE=10


# ----- Public addresses of the application (set them) -------------------------

# Not secret. Page of the web application that opens an access link, as it appears in every email.
# The single origin of the stack is app.<domain>.
AYNI_IDENTITY_ACCESS_LINK_BASE_URL=https://app.${AYNI_DOMAIN}/access/confirm

# Not secret. Origins allowed to call the API with a browser and to open the whiteboard's live
# channel, comma separated, no trailing slash. https://app.<domain> is where the web application
# is served.
AYNI_ALLOWED_ORIGINS=https://app.${AYNI_DOMAIN}

# Not secret. Public address of Jitsi, on the video machine: the one the video passes point the
# browser to.
AYNI_JITSI_URL=https://meet.${AYNI_DOMAIN}

# Not secret. Serves Swagger UI and /v3/api-docs at api.<domain>. Leave it false in production
# unless you need it, and then only for the time you need it.
AYNI_API_DOCS_ENABLED=false


# ----- Video (US08) -----------------------------------------------------------

# SECRET. Signs the video passes and is the secret Jitsi checks them with: deploy/jitsi/.env holds
# this same value. At least 32 characters or the backend refuses to start.
AYNI_JITSI_JWT_SECRET=change-me-at-least-32-characters-long-jitsi-secret

# Not secret. Application id the video passes carry, and the issuer Jitsi accepts. The same value
# as in deploy/jitsi/.env; the default works.
AYNI_JITSI_APP_ID=ayni


# ----- First administrator ----------------------------------------------------

# Not secret. Address of the first platform administrator. Set it for the first start, then the row
# exists and the variable can stay or go. It must be a real mailbox: the sign in link arrives there.
AYNI_BOOTSTRAP_ADMIN_EMAIL=admin@example.org

# Not secret. Their name.
AYNI_BOOTSTRAP_ADMIN_FULL_NAME=Ayni Platform Administrator


# ----- Mail (set them; deploy/README.md, "Mail", explains the two options) ------------

# Not secret. The SMTP server the emails go to. "mailpit" is the optional catcher of this stack
# (docker compose --profile mailpit); for real delivery, your provider's server.
AYNI_MAIL_HOST=mailpit

# Not secret. Its port: 1025 for Mailpit, usually 587 (STARTTLS) or 465 (TLS) for a provider.
AYNI_MAIL_PORT=1025

# Not secret. SMTP user, when the server asks for one. Empty for Mailpit.
AYNI_MAIL_USER=

# SECRET. SMTP password. Empty for Mailpit.
AYNI_MAIL_PASSWORD=

# Not secret. Sender of the emails. A real server only accepts a sender on a domain you verified
# with it.
AYNI_MAIL_FROM=Ayni <no-reply@example.org>

# Not secret. true on port 587 (the server upgrades to TLS with STARTTLS). Stays false for Mailpit.
AYNI_MAIL_STARTTLS=false

# Not secret. true on port 465 (TLS from the first byte). Stays false for Mailpit.
AYNI_MAIL_SSL=false


# ----- Real relay for a few addresses (optional; deploy/README.md, "Mail", option C) --------
# Leave all seven empty and every email leaves through the server above. Set the list and the host
# together: one without the other stops the backend from starting.

# Personal data, not a secret. Comma separated addresses whose emails leave through the real relay.
# Every other address still leaves through AYNI_MAIL_HOST. Compared whole and without regard to
# case, never by domain.
AYNI_REAL_RELAY_ALLOWED_RECIPIENTS=

# Not secret. The SMTP server of the real relay.
AYNI_REAL_RELAY_HOST=

# Not secret. Its port: usually 587 (STARTTLS) or 465 (TLS). Empty means 25.
AYNI_REAL_RELAY_PORT=

# Not secret. SMTP user, when the relay asks for one.
AYNI_REAL_RELAY_USERNAME=

# SECRET. SMTP password.
AYNI_REAL_RELAY_PASSWORD=

# Not secret. true on port 587.
AYNI_REAL_RELAY_STARTTLS=

# Not secret. true on port 465.
AYNI_REAL_RELAY_SSL=


# ----- Mailpit behind the proxy (only with the mailpit profile) ----------------

# Not secret. Starts the optional Mailpit with the rest, also when deploy/backend/update.sh
# restarts the stack. Leave it commented out when you send real email.
#COMPOSE_PROFILES=mailpit

# Not secret. Hostname the Mailpit page is served at, with its own DNS record. Leave it commented
# out unless you start the mailpit profile; commented out, the page is not exposed at all.
#MAILPIT_SITE=mail.example.org

# Not secret. User the proxy asks for.
#MAILPIT_BASIC_AUTH_USER=ayni

# SECRET (it hashes the password the proxy asks for). It asks for the password twice and prints the
# hash:
#   docker run --rm -it caddy:2.8.4-alpine caddy hash-password
# Keep the password itself in your password manager. The single quotes below matter: the hash holds
# dollar signs.
#MAILPIT_PASSWORD_HASH='$2a$14$replace-with-the-hash-caddy-printed'


# ----- Files (leave the defaults) ---------------------------------------------

# Not secret. Folder of the simulated academic system (ADR 0006), one <CODE>.json per university.
# The stack mounts a volume here. Keep the default: the volume takes the ownership of the image's
# folder, and any other path would be owned by root and unwritable for the application.
AYNI_ACADEMIC_DIRECTORY=/var/lib/ayni/academic-directory

# Not secret. Folder of the evidence files (US16), also a volume. Same advice.
AYNI_SKILLS_EVIDENCE_DIR=/var/lib/ayni/evidence


# ----- Purchases of credits (simulated provider; all optional) -----------------

# Not secret. Credits a student may buy per month (US35).
AYNI_PAYMENTS_MONTHLY_CREDIT_LIMIT=5

# Not secret. Price of a credit.
AYNI_PAYMENTS_PRICE_PER_CREDIT=5.00

# Not secret. When a pending purchase expires (ISO 8601 duration).
AYNI_PAYMENTS_PENDING_TIMEOUT=PT24H

# Not secret. How often pending purchases are reconciled.
AYNI_PAYMENTS_RECONCILIATION_DELAY=PT1M

# Not secret. The answer of the simulated provider to a charge: CONFIRMED, or another outcome of the
# simulation. There is no real payment provider behind it.
AYNI_PAYMENTS_SIMULATED_OUTCOME=CONFIRMED

# Not secret. Its answer when a purchase is reconciled.
AYNI_PAYMENTS_SIMULATED_RESOLUTION_OUTCOME=CONFIRMED

# Not secret. Failures that open the circuit of the provider (TS06).
AYNI_PAYMENTS_FAILURE_THRESHOLD=3

# Not secret. How long the circuit stays open.
AYNI_PAYMENTS_CIRCUIT_OPEN_DURATION=PT30S

# Not secret. Timeout of a call to the provider.
AYNI_PAYMENTS_TIMEOUT=PT2S

# Not secret. Calls to the provider at once.
AYNI_PAYMENTS_MAX_CONCURRENT_CALLS=2


# ----- Runtime (optional) -----------------------------------------------------

# Not secret. HTTP port inside the backend container. The proxy and the health check follow it.
AYNI_PORT=8080

# Not secret. Most memory the backend container may use. Past it the container is killed and
# restarted. The default fits a machine of 1 GB; deploy/README.md, "Memory", has the measurements.
AYNI_BACKEND_MEMORY_LIMIT=650m

# Not secret. Options of the JVM, measured to stay below the limit above with room to spare. Leave
# it commented out to keep them. On a larger machine raise -Xmx and the limit together.
#JAVA_TOOL_OPTIONS=-XX:+UseSerialGC -Xms128m -Xmx256m -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=48m -XX:MaxDirectMemorySize=32m -Xss512k -XX:TieredStopAtLevel=1

# Not secret. Requests the backend serves at once; each one holds a thread and its memory.
AYNI_TOMCAT_THREADS_MAX=50

# SPRING_PROFILES_ACTIVE is not read from here: docker-compose.yml fixes it to prod. Never
# run a deployment with dev, which seeds demonstration people.
